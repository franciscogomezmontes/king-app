# Copy to .env (gitignored) and adjust as needed.

# Default server address for Online Multiplayer's "Crear mesa"/"Unirse con código" fields —
# inlined into the client bundle at build time by Expo (EXPO_PUBLIC_* convention), read in
# apps/mobile/src/online/OnlineScreen.tsx. The field stays editable either way; this only
# pre-fills it when the player has no previously-saved address for this device yet (see
# apps/mobile/src/online/serverAddress.ts). Leave unset to start the field blank, as before.
# Point this at a deployed server's address once Online Multiplayer has one; localhost:2567
# is only meaningful when the King server (apps/server) is also running on this same machine.
EXPO_PUBLIC_KING_SERVER_URL=localhost:2567
