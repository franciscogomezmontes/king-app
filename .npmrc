# Expo's official pnpm-monorepo guidance (https://docs.expo.dev/guides/monorepos/): use a flat,
# hoisted node_modules instead of pnpm's default strict per-package isolation. Without this, pnpm
# can resolve a package like react-native to *different physical copies* for different workspace
# packages that declare it in different ways (apps/mobile's real dependency vs. packages/ui-kit's
# devDependency/peerDependency) — invisible on web (react-native-web has no native view registry),
# but on native it breaks any component whose JS-side registration and the app's actual native
# module instance don't match ("View config getter callback for component `X` must be a function
# (received `undefined`)" — hit for AndroidSwitch when testing Solo vs Computer on a real Android
# device via Expo Go). A single flat node_modules guarantees one shared instance of react/
# react-native across the whole workspace.
node-linker=hoisted
